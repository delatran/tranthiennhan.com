{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nhan-securities-local",
  "main": "./worker/cloudflare.js",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "SECURITIES_LOCAL_MODE": "true",
    "SECURITIES_MODEL_MODE": "off"
  },
  "d1_databases": [{
    "binding": "SECURITIES_DB",
    "database_name": "nhan-securities-local",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "./worker/securities/migrations"
  }],
  "dev": {
    "ip": "127.0.0.1",
    "port": 8788,
    "local_protocol": "http"
  },
  "observability": { "enabled": false }
}
