{
  "name": "tran-thien-nhan-portfolio",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:securities": "node scripts/securities/run-local.mjs",
    "test:securities": "node --test \"tests/securities/*.test.mjs\"",
    "verify:securities:live": "node scripts/securities/verify-live-report.mjs",
    "dev:cloudflare": "pnpm build && pnpm d1:migrate:local && wrangler dev",
    "build": "vite build && node scripts/build-localized-shells.mjs",
    "preview": "vite preview",
    "cloudflare:types": "wrangler types",
    "check:cloudflare-types": "wrangler types --check",
    "d1:migrate:local": "wrangler d1 migrations apply portfolio-visitor-analytics --local",
    "d1:migrate:production": "wrangler d1 migrations apply portfolio-visitor-analytics --remote",
    "d1:migrations:list": "wrangler d1 migrations list portfolio-visitor-analytics --remote",
    "verify:production": "pnpm check && pnpm check:cloudflare-types && node scripts/verify-wrangler-dry-run.mjs",
    "deploy:cloudflare:dry": "pnpm verify:production",
    "deploy:production": "pnpm verify:production && wrangler deploy --message \"Production #1: Nhan, Nhan and Nhan\"",
    "deploy:cloudflare": "pnpm deploy:production",
    "test:worker": "node --test tests/cloudflare-worker.test.mjs tests/production-config.test.mjs",
    "test:content": "node --test tests/content.test.mjs",
    "test:xnhan": "pnpm build && node --test \"tests/xnhan/*.test.mjs\"",
    "check": "pnpm build && node --test \"tests/**/*.test.mjs\"",
    "format:securities": "prettier --write \"src/securities/**/*.{js,jsx,css}\" \"shared/securities/*.js\" \"worker/securities/*.js\" \"scripts/securities/*.mjs\" \"tests/securities/*.mjs\" \"docs/securities*.md\" \"securities*.html\"",
    "format:securities:check": "prettier --check \"src/securities/**/*.{js,jsx,css}\" \"shared/securities/*.js\" \"worker/securities/*.js\" \"scripts/securities/*.mjs\" \"tests/securities/*.mjs\" \"docs/securities*.md\" \"securities*.html\""
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260822.1",
    "@napi-rs/canvas": "1.0.8",
    "@vitejs/plugin-react": "5.0.4",
    "pdfjs-dist": "6.3.289",
    "prettier": "3.9.6",
    "tesseract.js": "7.0.0",
    "vite": "6.4.3",
    "wrangler": "4.127.1"
  },
  "prettier": {
    "printWidth": 100
  }
}
